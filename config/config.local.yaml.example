# Salin file ini menjadi config.local.yaml dan isi dengan nilai Anda.
# File ini TIDAK di-commit (lihat .gitignore).
# Prioritas: environment variable > file ini > config.yaml.

database:
  dsn: "user:password@tcp(host:3306)/blockchain?parseTime=true&loc=Local"

redis:
  addr: "localhost:6379"
  password: ""

rabbitmq:
  url: "amqp://guest:guest@localhost:5672/"

jwt:
  # Generate dengan: openssl rand -base64 48
  # Validasi menolak panjang < 32 byte (lihat config.go validate()).
  user_secret: "your-user-jwt-secret-min-32-chars-replace-this"
  admin_secret: "your-admin-jwt-secret-min-32-chars-replace-this"

server:
  allowed_origins:
    - "http://localhost:3000"
