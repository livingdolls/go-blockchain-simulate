# File yang TIDAK perlu di-copy ke konteks Docker saat build.
# Mempercepat build dan mengurangi ukuran image.

# Output build
bin/
tmp/

# File konfigurasi lokal (berisi secret)
config/config.local.yaml
**/*.local.yaml

# VCS
.git/
.gitignore
.gitattributes

# Dokumentasi dan resource yang tidak dipakai binary
docs/
*.md
LICENSE

# File editor dan OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker (jika ada nested docker, hindari recursion)
# Production Dockerfile tetap di-ignore karena di-copy manual via image name.
Dockerfile
# TAPI Dockerfile.dev dan docker-compose*.yml HARUS ikut konteks build
# karena di-reference oleh docker-compose.dev.yml.
!Dockerfile.dev
!docker-compose.yml
!docker-compose.dev.yml
.dockerignore

# Test artifacts dan coverage
*.test
*.out
coverage.html

# Log
*.log

# Project subdir yang bukan bagian Go app (jangan trigger rebuild saat
# file di subdir ini berubah - lihat juga .air.toml exclude_dir).
YuteCoin/
view/
